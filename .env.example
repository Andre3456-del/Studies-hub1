# Copy this to .env for local use, or add each value in your hosting dashboard.
# Never commit the real .env file.

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=            # permanent access token from your Meta app
WHATSAPP_PHONE_ID=         # "Phone number ID" from WhatsApp > API Setup
VERIFY_TOKEN=              # any secret word you choose; paste the same one into Meta's webhook setup
APP_SECRET=                # Meta app > Settings > Basic > App secret
OWNER_PHONE=               # your WhatsApp number with country code, e.g. 2348012345678

# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- Your website (hosted on GitHub Pages) ---
GITHUB_TOKEN=              # fine-grained token with Contents: read and write on the site repo only
SITE_REPO=                 # owner/repo of your website, e.g. Andre3456-del/studieshub
SITE_BRANCH=main
SITE_URL=https://studieshub.org
